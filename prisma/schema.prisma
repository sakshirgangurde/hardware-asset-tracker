datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin User")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id             String              @id @default(uuid())
  name           String
  email          String              @unique
  department     String
  officeLocation String              @default("HYD") // HYD or MUM
  status         String              @default("ACTIVE") // ACTIVE or OFFBOARDED
  startDate      DateTime            @default(now())
  endDate        DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assets         Asset[]
  assignments    AssignmentHistory[]

  @@index([status])
  @@index([officeLocation])
}

model Asset {
  id             String              @id @default(uuid())
  assetTag       String              @unique
  name           String
  category       String              // Laptop, Desktop, Monitor, Peripheral, Networking, Other
  brand          String
  model          String
  serialNumber       String?
  status             String              @default("IN_STOCK") // IN_STOCK, IN_USE, UNDER_REPAIR, LOST, SCRAPPED
  employeeId         String?
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  officeLocation     String              @default("MUM") // HYD or MUM
  purchaseDate       DateTime?
  vendor             String?
  warrantyExpiry     DateTime?
  accessories        String?
  notes              String?
  // Excel Sheet Specific Fields
  sesaId             String?
  processor          String?
  ram                String?
  storage            String?
  configuration      String?
  inspectionDone     String?             // "Yes" | "NO"
  invoiceLink        String?
  warrantyStartDate  DateTime?
  warrantyEndDate    DateTime?
  extendWarrantyDate DateTime?
  extendUpto         String?
  serviceHistory     String?
  finalSummary       String?
  auditDate          String?
  antivirus          String?             // "Yes", "NO", "Installed", "Expired", "Not Avai", "NA"
  charger            String?
  currentUser        String?             // Raw user string from sheet
  lastUser           String?             // Multiline historical users list
  stateDetail        String?             // Original detailed status (e.g. Usable-SESA, Usable-NonSESA)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        AssignmentHistory[]
  maintenance        MaintenanceLog[]
  disposals          DisposalRecord[]

  @@index([status])
  @@index([category])
  @@index([officeLocation])
  @@index([employeeId])
  @@index([sesaId])
  @@index([serialNumber])
}

model AssignmentHistory {
  id           String    @id @default(uuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate DateTime  @default(now())
  returnedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([assetId])
  @@index([employeeId])
  @@index([returnedDate])
}

model MaintenanceLog {
  id               String    @id @default(uuid())
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  dateReported     DateTime  @default(now())
  issueDescription String
  sentTo           String
  dateReturned     DateTime?
  outcome          String    @default("PENDING") // REPAIRED, UNREPAIRABLE, PENDING
  performedBy      String
  createdAt        DateTime  @default(now())

  @@index([assetId])
  @@index([outcome])
}

model DisposalRecord {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  disposalDate   DateTime @default(now())
  disposalReason String   // DAMAGED_BEYOND_REPAIR, OBSOLETE, LOST, STOLEN, OTHER
  notes          String?
  createdAt      DateTime @default(now())

  @@index([assetId])
  @@index([disposalReason])
}
